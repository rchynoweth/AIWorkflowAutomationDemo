# Loan Servicing Intelligence - environment configuration (synthetic demonstration).
# Copy to .env for local development. Never commit real credentials.

# Demo mode: fixed seed, fixed processing date, synthetic adapter, resettable state.
DEMO_MODE=true

# Repository backend: "local" (CSV/JSONL files under ./data) or "databricks" (Delta tables via SQL warehouse).
LSI_REPOSITORY_BACKEND=local

# Agent mode: "auto" (LLM when reachable, otherwise deterministic), "llm", or "deterministic".
LSI_AGENT_MODE=auto
LSI_MODEL_ENDPOINT=databricks-claude-sonnet-5-5

# Optional override of the fixed demo processing date (YYYY-MM-DD).
# LSI_PROCESSING_DATE=2026-10-12

# Databricks backend settings (only needed when LSI_REPOSITORY_BACKEND=databricks).
LSI_CATALOG=main
LSI_SCHEMA=loan_servicing_intelligence
DATABRICKS_WAREHOUSE_ID=
# Authentication uses the standard Databricks SDK chain (profile, OAuth, or app service principal).
# DATABRICKS_CONFIG_PROFILE=DEFAULT

# Internal agent API used by the Streamlit UI.
LSI_API_PORT=8001
